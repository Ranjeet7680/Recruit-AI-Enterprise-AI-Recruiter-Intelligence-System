# ==============================================================================
# Nexora Enterprise AI Recruiter — Environment Configuration Template
# ==============================================================================

# Application Metadata
APP_NAME=Nexora Enterprise AI Recruiter
ENVIRONMENT=development
API_V1_STR=/api
DEBUG=false

# Security & Authentication
# Generate a strong 256-bit key for production
JWT_SECRET=nexora-enterprise-default-jwt-secret-replace-in-production-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Providers (Optional: System operates in deterministic offline mode if blank)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database Connection (Optional: In-memory/JSON store by default)
DATABASE_URL=

# Security & Feature Flags
DEMO_MODE=true
ENABLE_PROMPT_INJECTION_DEFENSE=true
ENABLE_DEMOGRAPHIC_MASKING_BY_DEFAULT=true

# CORS Allowed Origins
CORS_ORIGINS=["*"]
